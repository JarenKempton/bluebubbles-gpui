{
  "name": "Omarchy",
  "author": "Omarchy",
  "themes": [
    {
      "name": "Omarchy",
      "mode": "{{ mode }}",
      "font.family": "sans-serif",
      "font.size": 16,
      "radius": 8,
      "radius.lg": 12,
      "shadow": false,
      "colors": {
        "background": "{{ background }}",
        "foreground": "{{ foreground }}",
        "border": "{{ mix background muted 60% }}",
        "input.border": "{{ mix background muted 60% }}",
        "ring": "{{ accent }}",
        "caret": "{{ bright_foreground }}",
        "selection.background": "{{ mix background accent 35% }}",
        "muted.background": "{{ lighter_background }}",
        "muted.foreground": "{{ mix background foreground 60% }}",
        "accent.background": "{{ selection }}",
        "accent.foreground": "{{ bright_foreground }}",
        "primary.background": "{{ accent }}",
        "primary.hover.background": "{{ mix accent background 15% }}",
        "primary.active.background": "{{ mix accent background 30% }}",
        "primary.foreground": "{{ background }}",
        "secondary.background": "{{ mix background lighter_background 70% }}",
        "secondary.hover.background": "{{ mix dark_background accent 18% }}",
        "secondary.active.background": "{{ mix dark_background accent 18% }}",
        "secondary.foreground": "{{ foreground }}",
        "popover.background": "{{ mix background lighter_background 50% }}",
        "popover.foreground": "{{ foreground }}",
        "list.background": "{{ dark_background }}",
        "list.hover.background": "{{ mix dark_background foreground 6% }}",
        "list.active.background": "{{ mix dark_background accent 18% }}",
        "list.active.border": "{{ mix dark_background accent 18% }}",
        "sidebar.background": "{{ dark_background }}",
        "sidebar.foreground": "{{ foreground }}",
        "sidebar.border": "{{ muted }}",
        "title_bar.background": "{{ background }}",
        "title_bar.border": "{{ muted }}",
        "window.border": "{{ muted }}",
        "scrollbar.thumb.background": "{{ muted }}",
        "scrollbar.thumb.hover.background": "{{ dark_foreground }}",
        "link.foreground": "{{ accent }}",
        "button.info.background": "{{ magenta }}",
        "button.info.hover.background": "{{ mix magenta background 12% }}",
        "button.info.active.background": "{{ mix magenta background 24% }}",
        "button.info.foreground": "{{ background }}",
        "danger.background": "{{ red }}",
        "danger.foreground": "{{ background }}",
        "warning.background": "{{ yellow }}",
        "success.background": "{{ green }}",
        "base.red": "{{ red }}",
        "base.green": "{{ green }}",
        "base.yellow": "{{ yellow }}",
        "base.blue": "{{ blue }}",
        "base.magenta": "{{ magenta }}",
        "base.cyan": "{{ cyan }}"
      }
    }
  ]
}
